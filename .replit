modules = ["nodejs-20", "web"]
run = "npm install && npm run dev"
entrypoint = "src/main.tsx"

[nix]
channel = "stable-24_05"

[[ports]]
localPort = 5000
externalPort = 80

# Deployed copy runs as "staging": real server and database, but test data only
# (no real SSNs, bank accounts or cards). Add DATA_ENCRYPTION_KEY and
# DATA_HMAC_KEY in Secrets first, and create a PostgreSQL database.
[deployment]
deploymentTarget = "autoscale"
build = ["sh", "-c", "npm install && npm run build"]
run = ["sh", "-c", "APP_ENV=staging npm start"]
