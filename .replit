modules = ["nodejs-22", "web"]
run = "npm install && npm run dev"
entrypoint = "src/main.tsx"

[nix]
channel = "stable-24_05"

[[ports]]
localPort = 5000
externalPort = 80

# Deployed copy runs as "staging": real server and database, but test data only
# (no real SSNs, bank accounts or cards). Add DATA_ENCRYPTION_KEY and
# DATA_HMAC_KEY in Secrets first, and create a PostgreSQL database.
[deployment]
deploymentTarget = "autoscale"
build = ["sh", "-c", "npm install && npm run build"]
run = ["sh", "-c", "APP_ENV=staging npm start"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"
